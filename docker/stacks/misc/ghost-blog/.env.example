# Ghost Blog Configuration
# ========================

# Domain Settings
DOMAIN_NAME=blog.example.com

# Version Settings
GHOST_VERSION=5-alpine
MYSQL_VERSION=8.0

# Base Directory (usually $PWD)
PWD=/path/to/ghost-blog

# Database Settings
GHOST_DB_USER=ghost
GHOST_DB_PASSWORD=changeme_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# Caddy Settings
CADDY_VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443

# Backup Settings
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL=86400

# SMTP Settings (for email notifications)
# For Gmail: https://myaccount.google.com/apppasswords
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASSWORD=your-smtp-password
