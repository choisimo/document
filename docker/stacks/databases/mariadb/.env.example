# MariaDB Configuration
# ======================

# Container Settings
MARIADB_CONTAINER_NAME=mariadb

# Database Configuration
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_DATABASE=mydb
MARIADB_USER=dbuser
MARIADB_PASSWORD=changeme_password

# Port Configuration
MARIADB_PORT=3306

# Volume Paths
MARIADB_LIB_DIR=./data/mysql
MARIADB_BACKUP_DIR=./backups

# Network Configuration
MARIADB_INTERNAL_STATIC_IP=172.20.0.10
MARIADB_NETWORK_SUBNET=172.20.0.0/24
