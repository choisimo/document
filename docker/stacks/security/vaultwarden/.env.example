# Vaultwarden Docker Compose 환경 변수 템플릿
# 이 파일을 .env 로 복사하여 사용하세요: cp .env.example .env

# ==========================================
# 기본 설정
# ==========================================

# Vaultwarden 도메인 (HTTPS 필수)
DOMAIN=https://vault.example.com

# 타임존
TZ=Asia/Seoul

# ==========================================
# Vaultwarden 포트 설정
# ==========================================

# Vaultwarden HTTP 포트 (리버스 프록시 사용 시 로컬호스트만)
VAULTWARDEN_PORT=127.0.0.1:8080

# ==========================================
# 데이터 경로
# ==========================================

# Vaultwarden 데이터 저장 경로
VW_DATA_PATH=./data

# 백업 저장 경로
VW_BACKUP_PATH=./backups

# ==========================================
# 보안 설정
# ==========================================

# 관리자 토큰 (argon2 해시 권장)
# 생성 방법: echo -n "your-password" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
# ADMIN_TOKEN=

# 회원가입 허용 여부 (초기 설정 후 false 권장)
SIGNUPS_ALLOWED=false

# 초대 허용 여부
INVITATIONS_ALLOWED=true

# ==========================================
# Cloudflare Tunnel 설정 (docker-compose.cloudflared.yaml 사용 시)
# ==========================================

# Cloudflare Tunnel 토큰
# Cloudflare Zero Trust > Access > Tunnels 에서 생성
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ==========================================
# SSL/TLS 설정 (docker-compose.nginx.yaml 사용 시)
# ==========================================

# SSL 인증서 경로
SSL_CERT_PATH=./ssl/fullchain.pem
SSL_KEY_PATH=./ssl/privkey.pem

# ==========================================
# 백업 설정
# ==========================================

# 백업 스케줄 (cron 형식)
BACKUP_SCHEDULE=0 4 * * *

# 백업 파일 보존 기간 (일)
BACKUP_RETENTION_DAYS=30
