# n8n Automation Stack Configuration
# ====================================

# PostgreSQL Settings
POSTGRES_DB=n8n
POSTGRES_USER=n8nuser
POSTGRES_PASSWORD=changeme_password

# n8n Settings
N8N_PORT=5678
N8N_USER=admin
N8N_PASS=changeme_admin_password
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here
WEBHOOK_URL=https://n8n.example.com

# Redis Settings
REDIS_PASSWORD=changeme_redis_password

# MongoDB Settings
MONGODB_PORT=27017
MONGO_USER=mongouser
MONGO_PASSWORD=changeme_mongo_password

# Qdrant Vector DB
QDRANT_PORT=6333
QDRANT_API_KEY=changeme_qdrant_key

# Elasticsearch
ELASTICSEARCH_PORT=9200

# MinIO Object Storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme_minio_password

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASS=changeme_rabbitmq_password

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=changeme_grafana_password

# Database Admin Tools
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme_pgadmin_password
ADMINER_PORT=8080
REDIS_INSIGHT_PORT=8001

# Nginx Proxy Manager DB
NPM_DB_ROOT_PASSWORD=changeme_npm_root
NPM_DB_NAME=npm
NPM_DB_USER=npm
NPM_DB_PASSWORD=changeme_npm_password

# Firecrawl
API_BEARER_TOKEN=your-firecrawl-token
ANOTHER_VARIABLE=value
