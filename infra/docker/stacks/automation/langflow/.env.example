# Langflow Stack Configuration
# ============================

# General
TZ=Asia/Seoul

# Langflow
LANGFLOW_IMAGE=langflowai/langflow:latest
LANGFLOW_CONTAINER_NAME=langflow
LANGFLOW_PERMS_CONTAINER_NAME=langflow-perms
LANGFLOW_PORT=7860
LANGFLOW_BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_CONTAINER_NAME=langflow-postgres
POSTGRES_USER=langflow
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=langflow

# Optional Cloudflare Tunnel
CLOUDFLARED_CONTAINER_NAME=langflow-cloudflared
TUNNEL_TOKEN=
