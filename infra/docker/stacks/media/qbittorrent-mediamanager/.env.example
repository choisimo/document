# ============================================
# 시스템 공통 설정 (사용자 ID 확인: id $USER)
# ============================================
PUID=1000
PGID=1000
TZ=Asia/Seoul

# ============================================
# Gluetun VPN 설정 (NordVPN)
# ============================================
VPN_PROVIDER=nordvpn
VPN_TYPE=wireguard

# NordVPN WireGuard(NordLynx) 필수 키
# 추출 방법은 하단 설명 참조
# docker run --rm curlimages/curl -s -u "token:{token_value_on_it}" 
# https://api.nordvpn.com/v1/users/services/credentials
WIREGUARD_PRIVATE_KEY=
# 아래 두 값은 보통 자동 감지되지만, 필요시 입력 (비워둬도 됨)
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ADDRESSES=10.5.0.2/32

# OpenVPN 사용 시에만 필요 (WireGuard 사용 시 비워둠)
OPENVPN_USER=
OPENVPN_PASSWORD=

# ============================================
# 포트 포워딩 설정 (NordVPN은 미지원 -> off 필수)
# ============================================
# 중요: NordVPN은 포트 포워딩을 지원하지 않으므로 반드시 'off'로 설정해야 함
GLUETUN_PORT_FORWARDING=off
GLUETUN_PORT_FORWARDING_STATUS_FILE=/tmp/gluetun/forwarded_port

# ============================================
# qBittorrent 설정
# ============================================
QBITTORRENT_WEBUI_PORT=8080

# ============================================
# Port Manager 설정 (NordVPN 사용 시 작동 안 함)
# ============================================
# 에러 방지를 위한 더미 값들입니다.
PORT_MANAGER_QBITTORRENT_PORT=8080
PORT_MANAGER_PORT_FORWARDED_FILE=/tmp/gluetun/forwarded_port
PORT_MANAGER_GLUETUN_HOST=127.0.0.1
PORT_MANAGER_GLUETUN_PORT=8000

# ============================================
# Cloudflared 설정
# ============================================
# Cloudflare Zero Trust 대시보드에서 생성한 토큰 입력
CLOUDFLARED_TOKEN=