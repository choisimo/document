# AI Chatbot Configuration
# Only PUBLIC_* values are serialized into public JavaScript at build time.
# Every visitor can read them. Private provider keys belong in the backend proxy.
# See: content/docs/javascripts/ai-config.js

# AI API Server URL
PUBLIC_AI_API_BASE_URL=https://ai.dothechi.com/v1

# Optional intentionally public, least-privilege browser token. Never a private API key.
PUBLIC_AI_API_TOKEN=

# AI Model Name (leave empty to use backend default)
PUBLIC_AI_MODEL_NAME=

# Open Notebook Knowledge Base Integration
# See: https://github.com/lfnovo/open-notebook
PUBLIC_OPEN_NOTEBOOK_ENABLED=false
# Set an HTTPS browser-facing proxy URL when enabling this integration.
PUBLIC_OPEN_NOTEBOOK_URL=
PUBLIC_OPEN_NOTEBOOK_TOKEN=
