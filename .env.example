# AI Chatbot Configuration
# These values are injected at build time via GitHub Actions
# See: docs/javascripts/ai-config.js

# AI API Server URL
AI_API_BASE_URL=https://ai.dothechi.com

# AI API Authentication Token
AI_API_TOKEN=

# AI Model Name (leave empty to use backend default)
AI_MODEL_NAME=

# Open Notebook Knowledge Base Integration
# See: https://github.com/lfnovo/open-notebook
OPEN_NOTEBOOK_ENABLED=false
OPEN_NOTEBOOK_URL=http://localhost:8090
OPEN_NOTEBOOK_TOKEN=
