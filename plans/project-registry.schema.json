{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forgejo core project registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_date",
    "scope",
    "authority",
    "archive_policy",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_repository",
        "rule"
      ],
      "properties": {
        "registry_repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "archive_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_action",
        "require_all",
        "delete_policy"
      ],
      "properties": {
        "default_action": {
          "const": "none"
        },
        "require_all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delete_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "role",
          "lifecycle",
          "canonical",
          "open_prs",
          "source_of_truth",
          "status_note",
          "relations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "role": {
            "enum": [
              "platform",
              "runtime",
              "tooling",
              "product",
              "service",
              "content",
              "content-product",
              "content-platform",
              "infrastructure"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "review",
              "maintenance",
              "historical",
              "temporary",
              "archived"
            ]
          },
          "canonical": {
            "type": "boolean"
          },
          "last_observed_main": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "open_prs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "source_of_truth": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status_note": {
            "type": "string",
            "minLength": 1
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project",
                "kind",
                "state"
              ],
              "properties": {
                "project": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": [
                    "observed",
                    "planned",
                    "proposed",
                    "review"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
