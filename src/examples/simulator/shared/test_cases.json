{
  "testCases": {
    "insert": [
      {
        "name": "Basic Insert",
        "description": "Insert values in order: 5, 3, 7, 1, 4, 6, 8",
        "operations": [
          {"type": "insert", "value": 5},
          {"type": "insert", "value": 3},
          {"type": "insert", "value": 7},
          {"type": "insert", "value": 1},
          {"type": "insert", "value": 4},
          {"type": "insert", "value": 6},
          {"type": "insert", "value": 8}
        ],
        "expectedInorder": [1, 3, 4, 5, 6, 7, 8],
        "expectedHeight": 2
      },
      {
        "name": "Skewed Tree (Ascending)",
        "description": "Insert ascending values to create a right-skewed tree",
        "operations": [
          {"type": "insert", "value": 1},
          {"type": "insert", "value": 2},
          {"type": "insert", "value": 3},
          {"type": "insert", "value": 4},
          {"type": "insert", "value": 5}
        ],
        "expectedInorder": [1, 2, 3, 4, 5],
        "expectedHeight": 4
      },
      {
        "name": "Duplicate Handling",
        "description": "Insert duplicate values",
        "operations": [
          {"type": "insert", "value": 5},
          {"type": "insert", "value": 3},
          {"type": "insert", "value": 5},
          {"type": "insert", "value": 3}
        ],
        "expectedInorder": [3, 5],
        "expectedSize": 2
      }
    ],
    "search": [
      {
        "name": "Search Existing",
        "description": "Search for values that exist",
        "setup": [5, 3, 7, 1, 4],
        "operations": [
          {"type": "search", "value": 4, "expected": true},
          {"type": "search", "value": 5, "expected": true},
          {"type": "search", "value": 1, "expected": true}
        ]
      },
      {
        "name": "Search Non-Existing",
        "description": "Search for values that don't exist",
        "setup": [5, 3, 7],
        "operations": [
          {"type": "search", "value": 10, "expected": false},
          {"type": "search", "value": 0, "expected": false}
        ]
      }
    ],
    "delete": [
      {
        "name": "Delete Leaf Node",
        "description": "Delete a node with no children",
        "setup": [5, 3, 7, 1],
        "operations": [
          {"type": "delete", "value": 1}
        ],
        "expectedInorder": [3, 5, 7]
      },
      {
        "name": "Delete Node with One Child",
        "description": "Delete a node with exactly one child",
        "setup": [5, 3, 7, 1],
        "operations": [
          {"type": "delete", "value": 3}
        ],
        "expectedInorder": [1, 5, 7]
      },
      {
        "name": "Delete Node with Two Children",
        "description": "Delete a node with two children (uses in-order successor)",
        "setup": [5, 3, 7, 1, 4, 6, 8],
        "operations": [
          {"type": "delete", "value": 5}
        ],
        "expectedInorder": [1, 3, 4, 6, 7, 8]
      },
      {
        "name": "Delete Root",
        "description": "Delete the root node",
        "setup": [5, 3, 7],
        "operations": [
          {"type": "delete", "value": 5}
        ],
        "expectedInorder": [3, 7]
      }
    ],
    "traversal": [
      {
        "name": "All Traversals",
        "description": "Test all three traversal orders",
        "setup": [5, 3, 7, 1, 4, 6, 8],
        "expected": {
          "inorder": [1, 3, 4, 5, 6, 7, 8],
          "preorder": [5, 3, 1, 4, 7, 6, 8],
          "postorder": [1, 4, 3, 6, 8, 7, 5]
        }
      }
    ]
  },
  "demoScenarios": {
    "basic": {
      "name": "Basic BST Operations",
      "description": "Demonstrates insert, search, and delete operations",
      "steps": [
        {"action": "insert", "values": [50, 30, 70, 20, 40, 60, 80]},
        {"action": "search", "value": 40},
        {"action": "delete", "value": 30}
      ]
    },
    "balanced": {
      "name": "Building a Balanced Tree",
      "description": "Insert values to create a balanced BST",
      "steps": [
        {"action": "insert", "values": [50, 25, 75, 12, 37, 62, 87]}
      ]
    },
    "deleteAllCases": {
      "name": "Delete - All Three Cases",
      "description": "Demonstrates all three deletion cases",
      "steps": [
        {"action": "insert", "values": [50, 30, 70, 20, 40, 60, 80]},
        {"action": "delete", "value": 20, "comment": "Case 1: Leaf node"},
        {"action": "delete", "value": 70, "comment": "Case 2: One child"},
        {"action": "delete", "value": 50, "comment": "Case 3: Two children"}
      ]
    }
  }
}
