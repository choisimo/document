map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream consul_upstream {
  server consul:8500;
}

upstream vault_upstream {
  server vault:8200;
}

upstream minio_api_upstream {
  server {{ hostvars[groups['infra_minio'][0]].ansible_host | default(groups['infra_minio'][0]) }}:9000;
}

upstream minio_console_upstream {
  server {{ hostvars[groups['infra_minio'][0]].ansible_host | default(groups['infra_minio'][0]) }}:9001;
}

upstream headscale_upstream {
  server {{ hostvars[groups['infra_headscale'][0]].ansible_host | default(groups['infra_headscale'][0]) }}:8080;
}

server {
  listen 80;
  server_name consul.{{ platform_domain }};

  location / {
    proxy_pass http://consul_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name vault.{{ platform_domain }};

  location / {
    proxy_pass http://vault_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name minio.{{ platform_domain }};

  location / {
    proxy_pass http://minio_api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name minio-console.{{ platform_domain }};

  location / {
    proxy_pass http://minio_console_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name headscale.{{ platform_domain }};

  location / {
    proxy_pass http://headscale_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
