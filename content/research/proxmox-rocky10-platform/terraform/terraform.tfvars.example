proxmox_endpoint   = "https://pve.example.com:8006"
proxmox_api_token  = "terraform@pve!automation=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure   = true
proxmox_node_name  = "pve"
vm_datastore       = "local-lvm"
file_datastore     = "local"
cloudinit_datastore = "local-lvm"

# Rocky Linux 10 cloud image (validated on 2026-02-13)
rocky_image_url = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-GenericCloud-Base.latest.x86_64.qcow2"

template_name = "rocky10-template"
template_vm_id = 9000

network_bridge = "vmbr0"
network_vlan_id = null
ipv4_cidr = 24
ipv4_gateway = "10.10.10.1"
dns_servers = ["10.10.10.2", "1.1.1.1"]
dns_domain = "lab.local"

vm_default_user = "nodove"
vm_default_password = null
vm_authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLE_REPLACE_WITH_REAL_KEY nodove@laptop",
  "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQDEXAMPLE_REPLACE_WITH_REAL_KEY nodove@workstation"
]

vm_definitions = {
  infra-01 = {
    vm_id        = 9001
    role         = "infra_core"
    ipv4_address = "10.10.10.11"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 40
    tags         = ["infra", "consul", "vault", "nginx"]
  }

  infra-02 = {
    vm_id        = 9002
    role         = "infra_minio"
    ipv4_address = "10.10.10.12"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 120
    tags         = ["infra", "minio"]
  }

  infra-03 = {
    vm_id        = 9003
    role         = "infra_headscale"
    ipv4_address = "10.10.10.13"
    cpu_cores    = 2
    memory_mb    = 2048
    disk_gb      = 40
    tags         = ["infra", "headscale"]
  }

  app-01 = {
    vm_id        = 9004
    role         = "app"
    ipv4_address = "10.10.10.21"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 80
    tags         = ["app", "docker"]
  }

  app-02 = {
    vm_id        = 9005
    role         = "app"
    ipv4_address = "10.10.10.22"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 80
    tags         = ["app", "docker"]
  }

  app-03 = {
    vm_id        = 9006
    role         = "app"
    ipv4_address = "10.10.10.23"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 80
    tags         = ["app", "docker"]
  }

  app-04 = {
    vm_id        = 9007
    role         = "app"
    ipv4_address = "10.10.10.24"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 80
    tags         = ["app", "docker"]
  }

  app-05 = {
    vm_id        = 9008
    role         = "app"
    ipv4_address = "10.10.10.25"
    cpu_cores    = 2
    memory_mb    = 4096
    disk_gb      = 80
    tags         = ["app", "docker"]
  }
}
